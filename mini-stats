#!/bin/bash
# Prints this Mac's CPU idle %, memory free %, Claude 5-hour % and Claude weekly %, for machines-dashboard.
# setup.sh installs it, and makes it the stats user's only shell on every Mac mini but mini-1.
idle=$(/usr/bin/top -l 2 -n 0 -s 1 | /usr/bin/awk '/CPU usage/ {v=$7} END {sub("%", "", v); print v}')
free=$(/usr/bin/memory_pressure -Q | /usr/bin/awk -F': ' '/free percentage/ {sub("%", "", $2); print $2}')
limits=$(/usr/bin/jq -r '[.five_hour, .seven_day]
  | map(if (.resets_at // 0) > now then (.used_percentage | floor | tostring) else "-" end)
  | join(" ")' /Users/Shared/claude-usage/latest.json 2>/dev/null)
echo "$idle $free ${limits:-- -}"
